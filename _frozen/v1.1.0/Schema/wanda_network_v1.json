{
 "schema": "wanda_network_v1",
 "version": "1.1.0",
 "status": "v1.1.0 for James's signature (not yet signed - see WI_Schema_v1.md change log and open points)",
 "description": "WANDa network GIS. One GeoPackage, one layer per kind (layer name = kind name), EPSG:27700, coordinates in metres. Layers are aligned to the PLDR project tables (app_table / app). The converter changes only layer names, field names and the delivery's own codes; values (coordinates, diameters, lengths, dates, refs) are as delivered. App behaviour comes from ONE rule per code attribute (rules), never from per-client tables.",
 "container": {
  "format": "gpkg",
  "file": "wanda_network.gpkg",
  "crs": "EPSG:27700",
  "coordinate_units": "m",
  "attribute_tables": [
   "dma_subs"
  ],
  "delivery_file": "wanda_delivery.json",
  "polygons": "MultiPolygon layers accept Polygon rows",
  "row_order": "the converter keeps the source row order within each layer (readers that keep the first of duplicate refs depend on it)",
  "lines": "pipes is a LineString layer: the converter merges a multi-part line whose parts join into one LineString; a multi-part line whose parts do not join is kept as MultiLineString in the same layer with pipes.multipart = '1' (the only multi geometry a line layer may hold)"
 },
 "types": {
  "ref": "text exactly as delivered (a float id 12345.0 is written 12345; leading zeros kept); never changed",
  "text": "free text as delivered (phone numbers / e-mail addresses inside free text are removed)",
  "code": "a code from the field's code list",
  "date": "ISO 8601 date yyyy-mm-dd (stored as text)",
  "datetime": "ISO 8601 yyyy-mm-dd, or yyyy-mm-ddThh:mm:ss when a time is known",
  "time": "hh:mm (24 h)",
  "number": "decimal number",
  "int": "whole number",
  "bool": "'1' = yes, blank = not said",
  "list": "several refs separated by ';'"
 },
 "ref_rules": [
  "Every *_ref field is text exactly as delivered: trimmed, case kept, leading zeros kept, a float id 12345.0 written 12345.",
  "ref_to names the layer.field a ref points at (a list = any of them; a node ref may name a junction, a pipe end or a point asset that is its own network node, e.g. a valve); ref_check must_exist = an error when the target layer is delivered and the value is missing from it; should_exist = counted and reported (e.g. a node ref to a site / pump junction).",
  "unique lists each layer's key (never blank); unique_check warn = duplicates reported, the reader keeps the first (hydrants, meters); a layer with no unique list (dma_areas) may repeat its ref.",
  "Area refs on assets (dma_ref, wqz_ref ...) are the delivery's own; the apps may also assign by polygon (dma_areas).",
  "A list field holds refs separated by ';' with no spaces."
 ],
 "rules": [
  {
   "id": "R1",
   "code_list": "status",
   "attribute": "in_network",
   "applies_to": [
    "pipes",
    "valves",
    "hydrants",
    "meters"
   ],
   "rule": "Every asset is loaded; only in_network assets build the network the apps analyse (traces, isolation, property links). Blank status counts as unknown (in_network)."
  },
  {
   "id": "R2",
   "code_list": "pipe_function",
   "attribute": "serves_customers",
   "applies_to": [
    "pipes",
    "properties"
   ],
   "rule": "A property snaps only to a serves_customers pipe; a delivered properties.pipe_ref is kept as given."
  },
  {
   "id": "R3",
   "code_list": "pipe_function",
   "attribute": "potable_network",
   "applies_to": [
    "pipes"
   ],
   "rule": "Only potable_network pipes enter the potable network (raw and non-potable mains are kept, not analysed)."
  },
  {
   "id": "R4",
   "code_list": "valve_type",
   "attribute": "isolates",
   "applies_to": [
    "valves"
   ],
   "rule": "An isolates valve stops an isolation trace (gis_valves.is_gate_valve = 1)."
  },
  {
   "id": "R5",
   "code_list": "normal_position",
   "attribute": "shut",
   "applies_to": [
    "valves"
   ],
   "rule": "A shut valve is a boundary in the network as delivered (closed); unknown and throttled count as open."
  },
  {
   "id": "R6",
   "code_list": "meter_function",
   "attribute": "network",
   "applies_to": [
    "meters"
   ],
   "rule": "Only network meters are loaded into gis_meters (DMA inlets, bulk, reservoir, trunk, supply)."
  },
  {
   "id": "R7",
   "code_list": "area_type",
   "attribute": "is_dma",
   "applies_to": [
    "dma_areas"
   ],
   "rule": "Only is_dma areas become DMA polygons in the apps; other districts are kept, not used as DMAs."
  },
  {
   "id": "R8",
   "code_list": "material",
   "attribute": "band",
   "applies_to": [
    "pipes"
   ],
   "rule": "Discolouration risk band of the material (unknown = 3)."
  },
  {
   "id": "R9",
   "code_list": "hydrant_class",
   "attribute": "supply_tier",
   "applies_to": [
    "hydrants"
   ],
   "rule": "Hydrant tier for tankering / injection / overland supply (1 = first choice, 2 = second, 0 = not used)."
  },
  {
   "id": "R10",
   "code_list": "units",
   "attribute": "factor",
   "applies_to": [
    "pipes"
   ],
   "rule": "diameter x factor = mm (per row by diameter_units); coordinates are metres BNG."
  }
 ],
 "kinds": {
  "pipes": {
   "geometry": "LineString",
   "description": "Water mains of every function and status (status / pipe_function say which the apps analyse - rules R1-R3). from / to node refs are as delivered: their order may follow digitising or flow (the mapping's app_options.pipe_node_order says which); the apps take topology from the node refs, not from the vertex order.",
   "unique": [
    [
     "pipe_ref"
    ]
   ],
   "app_table": "gis_pipes",
   "fields": [
    {
     "name": "pipe_ref",
     "type": "ref",
     "required": true,
     "description": "Pipe reference - the label the hydraulic model carries",
     "app": "gis_pipes.pipe_ref"
    },
    {
     "name": "pipe_function",
     "type": "code",
     "required": true,
     "code_list": "pipe_function",
     "description": "What the main does (rules R2 serves_customers, R3 potable_network)",
     "app": "gis_pipes.pipe_type"
    },
    {
     "name": "diameter",
     "type": "number",
     "required": true,
     "description": "Nominal diameter as delivered, in diameter_units",
     "app": "gis_pipes.diameter_value"
    },
    {
     "name": "diameter_units",
     "type": "code",
     "required": true,
     "code_list": "units",
     "description": "Units of diameter, per row (units group 'diameter': mm or in)",
     "app": "gis_pipes.diameter_units"
    },
    {
     "name": "material",
     "type": "code",
     "required": true,
     "code_list": "material",
     "description": "WI material code (rule R8 material.band)",
     "app": "gis_pipes.material"
    },
    {
     "name": "from_node_ref",
     "type": "ref",
     "required": false,
     "description": "Start junction (node-id topology); blank = the app builds nodes from the pipe ends",
     "ref_to": [
      "nodes.node_ref",
      "valves.node_ref",
      "hydrants.node_ref",
      "meters.node_ref",
      "pumps.node_ref",
      "sites.node_ref"
     ],
     "ref_check": "should_exist",
     "app": "gis_pipes.from_node_id (app node id)"
    },
    {
     "name": "to_node_ref",
     "type": "ref",
     "required": false,
     "description": "End junction",
     "ref_to": [
      "nodes.node_ref",
      "valves.node_ref",
      "hydrants.node_ref",
      "meters.node_ref",
      "pumps.node_ref",
      "sites.node_ref"
     ],
     "ref_check": "should_exist",
     "app": "gis_pipes.to_node_id (app node id)"
    },
    {
     "name": "length_m",
     "type": "number",
     "required": false,
     "units": "m",
     "description": "Measured length (blank = from the geometry)",
     "app": "gis_pipes.length_m"
    },
    {
     "name": "status",
     "type": "code",
     "required": false,
     "code_list": "status",
     "description": "Asset status (rule R1 status.in_network)",
     "app": "gis_pipes.operational_status"
    },
    {
     "name": "water_type",
     "type": "code",
     "required": false,
     "code_list": "water_type",
     "description": "Water type",
     "app": "gis_pipes.water_type"
    },
    {
     "name": "dma_ref",
     "type": "ref",
     "required": false,
     "description": "DMA the pipe belongs to",
     "ref_to": "dma_areas.dma_ref",
     "ref_check": "should_exist",
     "app": "gis_pipes.dma_ref"
    },
    {
     "name": "dma_sub_ref",
     "type": "ref",
     "required": false,
     "description": "DMA sub-area (pressure / control area inside the DMA)",
     "ref_to": "dma_subs.dma_sub_ref",
     "ref_check": "should_exist",
     "app": "gis_pipes.dma_subzone_ref"
    },
    {
     "name": "dma_sub_type",
     "type": "text",
     "required": false,
     "description": "The delivery's own kind of the sub-area (e.g. its pressure-area / planning-area code), as delivered or a mapping constant",
     "app": "gis_pipes.dma_subzone_type"
    },
    {
     "name": "wqz_ref",
     "type": "ref",
     "required": false,
     "description": "Water quality / supply zone",
     "ref_to": "supply_zones.wqz_ref",
     "ref_check": "should_exist",
     "app": "gis_pipes.wqz_ref"
    },
    {
     "name": "control_group_ref",
     "type": "ref",
     "required": false,
     "description": "Control group / DMZ",
     "ref_to": "control_groups.control_group_ref",
     "ref_check": "should_exist",
     "app": "gis_pipes.control_group"
    },
    {
     "name": "sub_region_ref",
     "type": "ref",
     "required": false,
     "description": "Sub-region",
     "ref_to": "sub_regions.sub_region_ref",
     "ref_check": "should_exist",
     "app": "gis_pipes.area_extra_1_ref (type sub_region) - open point"
    },
    {
     "name": "region_ref",
     "type": "ref",
     "required": false,
     "description": "Region / division",
     "ref_to": "regions.region_ref",
     "ref_check": "should_exist",
     "app": "gis_pipes.region_ref"
    },
    {
     "name": "model_area_ref",
     "type": "ref",
     "required": false,
     "description": "Hydraulic model area",
     "ref_to": "model_areas.model_area_ref",
     "ref_check": "should_exist"
    },
    {
     "name": "installed_date",
     "type": "date",
     "required": false,
     "description": "Installation date",
     "app": "gis_pipes.installed_date"
    },
    {
     "name": "lining_current",
     "type": "code",
     "required": false,
     "code_list": "lining",
     "description": "Current lining",
     "app": "gis_pipes.lining_current"
    },
    {
     "name": "lining_factory",
     "type": "code",
     "required": false,
     "code_list": "lining",
     "description": "Factory lining",
     "app": "gis_pipes.lining_factory"
    },
    {
     "name": "lining_previous",
     "type": "code",
     "required": false,
     "code_list": "lining",
     "description": "Previous lining",
     "app": "gis_pipes.lining_previous"
    },
    {
     "name": "lining_date",
     "type": "date",
     "required": false,
     "description": "Date of the current lining"
    },
    {
     "name": "multipart",
     "type": "bool",
     "required": false,
     "description": "'1' = the delivered line has parts that do not join; geometry kept as MultiLineString (blank = one LineString)"
    }
   ],
   "geometry_accepts": [
    "LineString",
    "MultiLineString (multipart = '1' only)"
   ]
  },
  "nodes": {
   "geometry": "Point",
   "description": "Network junctions that pipe from / to node refs name (node-id topology): fed from the delivery's fitting / joint / connection / junction / water-point layers. A point asset that is its own network node (valve, hydrant, meter) carries its node ref in its own layer and may also appear here. Without nodes the app builds nodes from the pipe ends (coordinate topology).",
   "unique": [
    [
     "node_ref"
    ]
   ],
   "app_table": "gis_nodes",
   "fields": [
    {
     "name": "node_ref",
     "type": "ref",
     "required": true,
     "description": "Junction reference",
     "app": "gis_nodes (app node_id; ref kept for matching)"
    },
    {
     "name": "elevation_m",
     "type": "number",
     "required": false,
     "units": "m AOD",
     "description": "Ground level",
     "app": "gis_nodes.elevation_m"
    }
   ]
  },
  "elevation_points": {
   "geometry": "Point",
   "description": "Ground-level points (spot heights) for pipe / asset elevation where nodes carry none: the apps join the nearest point (WDA pipe elevation). Optional; a delivery whose nodes carry elevation_m needs none.",
   "unique": [],
   "app_table": "wda gis_pipes.elevation (nearest point)",
   "fields": [
    {
     "name": "point_ref",
     "type": "ref",
     "required": false,
     "description": "Point reference as delivered (not joined to anything)"
    },
    {
     "name": "elevation_m",
     "type": "number",
     "required": true,
     "units": "m AOD",
     "description": "Ground level",
     "app": "wda gis_pipes.elevation"
    }
   ]
  },
  "valves": {
   "geometry": "Point",
   "description": "Valves of every type, incl. regulators (PRV / PSV / flow control), non-return and air valves.",
   "unique": [
    [
     "valve_ref"
    ]
   ],
   "app_table": "gis_valves",
   "fields": [
    {
     "name": "valve_ref",
     "type": "ref",
     "required": true,
     "description": "Valve reference",
     "app": "gis_valves.valve_ref"
    },
    {
     "name": "valve_type",
     "type": "code",
     "required": true,
     "code_list": "valve_type",
     "description": "WI valve type (rule R4 valve_type.isolates)",
     "app": "gis_valves.valve_type + is_gate_valve (R4)"
    },
    {
     "name": "regulator_type",
     "type": "text",
     "required": false,
     "description": "Regulator type as delivered (PRV / PSV / flow control ...; valve_type holds the WI code)",
     "app": "gis_valves.regulator_type"
    },
    {
     "name": "node_ref",
     "type": "ref",
     "required": false,
     "description": "Network node the asset sits on / is (when the delivery has node ids)",
     "ref_to": [
      "nodes.node_ref",
      "pipes.from_node_ref",
      "pipes.to_node_ref"
     ],
     "ref_check": "should_exist",
     "app": "gis_valves.node_id (matched)"
    },
    {
     "name": "normal_position",
     "type": "code",
     "required": false,
     "code_list": "normal_position",
     "description": "Normal position (rule R5 normal_position.shut)",
     "app": "gis_valves.normal_position"
    },
    {
     "name": "status",
     "type": "code",
     "required": false,
     "code_list": "status",
     "description": "Asset status (rule R1 status.in_network)",
     "app": "gis_valves.operational_status"
    },
    {
     "name": "dma_ref",
     "type": "ref",
     "required": false,
     "description": "DMA the asset is in (DMA polygons decide when this is blank)",
     "ref_to": "dma_areas.dma_ref",
     "ref_check": "should_exist",
     "app": "gis_valves.dma_ref"
    },
    {
     "name": "elevation_m",
     "type": "number",
     "required": false,
     "units": "m AOD",
     "description": "Ground level",
     "app": "gis_valves.elevation_m"
    },
    {
     "name": "installed_date",
     "type": "date",
     "required": false,
     "description": "Installation date"
    }
   ]
  },
  "hydrants": {
   "geometry": "Point",
   "description": "Hydrants (fire and washout).",
   "unique": [
    [
     "hydrant_ref"
    ]
   ],
   "unique_check": "warn",
   "app_table": "gis_hydrants",
   "fields": [
    {
     "name": "hydrant_ref",
     "type": "ref",
     "required": true,
     "description": "Hydrant reference (the hydrant label in the model)",
     "app": "gis_hydrants.hydrant_ref"
    },
    {
     "name": "hydrant_type",
     "type": "code",
     "required": false,
     "code_list": "hydrant_type",
     "description": "Hydrant function (fire / washout ...)",
     "app": "gis_hydrants.subtype_code"
    },
    {
     "name": "hydrant_class",
     "type": "code",
     "required": false,
     "code_list": "hydrant_class",
     "description": "Bore / jumper class FB / FJ / LJ (rule R9 hydrant_class.supply_tier)",
     "app": "gis_hydrants.jumper_type"
    },
    {
     "name": "outlet_arrangement",
     "type": "code",
     "required": false,
     "code_list": "outlet_arrangement",
     "description": "Single / double outlet",
     "app": "gis_hydrants.outlet_arrangement"
    },
    {
     "name": "node_ref",
     "type": "ref",
     "required": false,
     "description": "Network node the asset sits on / is (when the delivery has node ids)",
     "ref_to": [
      "nodes.node_ref",
      "pipes.from_node_ref",
      "pipes.to_node_ref"
     ],
     "ref_check": "should_exist",
     "app": "gis_hydrants.junction_id"
    },
    {
     "name": "status",
     "type": "code",
     "required": false,
     "code_list": "status",
     "description": "Asset status (rule R1 status.in_network)",
     "app": "gis_hydrants.operational_status"
    },
    {
     "name": "dma_ref",
     "type": "ref",
     "required": false,
     "description": "DMA the asset is in (DMA polygons decide when this is blank)",
     "ref_to": "dma_areas.dma_ref",
     "ref_check": "should_exist",
     "app": "gis_hydrants.dma_ref"
    },
    {
     "name": "control_group_ref",
     "type": "ref",
     "required": false,
     "description": "Control group / DMZ",
     "ref_to": "control_groups.control_group_ref",
     "ref_check": "should_exist",
     "app": "gis_hydrants.raw_attrs"
    },
    {
     "name": "elevation_m",
     "type": "number",
     "required": false,
     "units": "m AOD",
     "description": "Ground level",
     "app": "gis_hydrants.elevation_m"
    },
    {
     "name": "installed_date",
     "type": "date",
     "required": false,
     "description": "Installation date",
     "app": "gis_hydrants.installed_date"
    }
   ]
  },
  "meters": {
   "geometry": "Point",
   "description": "Meters. The apps use network meters only (rule R6 meter_function.network).",
   "unique": [
    [
     "meter_ref"
    ]
   ],
   "unique_check": "warn",
   "app_table": "gis_meters",
   "fields": [
    {
     "name": "meter_ref",
     "type": "ref",
     "required": true,
     "description": "Meter reference",
     "app": "gis_meters.meter_ref"
    },
    {
     "name": "meter_function",
     "type": "code",
     "required": true,
     "code_list": "meter_function",
     "description": "What the meter measures (rule R6 meter_function.network)",
     "app": "gis_meters.meter_class"
    },
    {
     "name": "node_ref",
     "type": "ref",
     "required": false,
     "description": "Network node the asset sits on / is (when the delivery has node ids)",
     "ref_to": [
      "nodes.node_ref",
      "pipes.from_node_ref",
      "pipes.to_node_ref"
     ],
     "ref_check": "should_exist",
     "app": "gis_meters.source_junction_id"
    },
    {
     "name": "pipe_ref",
     "type": "ref",
     "required": false,
     "description": "Pipe the meter is on",
     "ref_to": "pipes.pipe_ref",
     "ref_check": "should_exist"
    },
    {
     "name": "site_ref",
     "type": "ref",
     "required": false,
     "description": "Meter site (chamber) reference"
    },
    {
     "name": "dma_ref",
     "type": "ref",
     "required": false,
     "description": "DMA the meter feeds (to)",
     "ref_to": "dma_areas.dma_ref",
     "ref_check": "should_exist",
     "app": "gis_meters.dma_ref"
    },
    {
     "name": "dma_from_ref",
     "type": "ref",
     "required": false,
     "description": "DMA / zone the meter takes from",
     "ref_to": "dma_areas.dma_ref",
     "ref_check": "should_exist"
    },
    {
     "name": "control_group_ref",
     "type": "ref",
     "required": false,
     "description": "Control group / DMZ",
     "ref_to": "control_groups.control_group_ref",
     "ref_check": "should_exist",
     "app": "gis_meters.raw_attrs"
    },
    {
     "name": "meter_type",
     "type": "text",
     "required": false,
     "description": "Meter type as delivered (electromagnetic, mechanical ...)",
     "app": "gis_meters.meter_type"
    },
    {
     "name": "status",
     "type": "code",
     "required": false,
     "code_list": "status",
     "description": "Asset status (rule R1 status.in_network)",
     "app": "gis_meters.operational_status"
    }
   ]
  },
  "properties": {
   "geometry": "Point",
   "description": "Customer properties (supply points). No personal fields: no names of people, phone numbers, e-mail addresses, priority-service / medical flags.",
   "unique": [
    [
     "property_ref"
    ]
   ],
   "app_table": "gis_properties",
   "fields": [
    {
     "name": "property_ref",
     "type": "ref",
     "required": true,
     "description": "Property reference (e.g. UPRN or supply point id)",
     "app": "gis_properties.property_no"
    },
    {
     "name": "pipe_ref",
     "type": "ref",
     "required": false,
     "description": "Main the property is supplied from, when delivered (rule R2 decides a snap)",
     "ref_to": "pipes.pipe_ref",
     "ref_check": "should_exist",
     "app": "gis_properties.source_pipe_ref"
    },
    {
     "name": "dma_ref",
     "type": "ref",
     "required": false,
     "description": "DMA",
     "ref_to": "dma_areas.dma_ref",
     "ref_check": "should_exist",
     "app": "gis_properties.dma_ref"
    },
    {
     "name": "customer_type",
     "type": "code",
     "required": false,
     "code_list": "customer_type",
     "description": "Household / non-household"
    },
    {
     "name": "non_household_type",
     "type": "code",
     "required": false,
     "code_list": "non_household_type",
     "description": "Kind of non-household premises"
    },
    {
     "name": "building_no",
